# Railway deployment variables. Do not commit real secret values.
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
SOLID_QUEUE_IN_PUMA=true

# Railway reference variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Generate once with `bin/rails secret` and save it as a Railway secret.
SECRET_KEY_BASE=
