- content_for(:full_width_layout, true)
= render "characters/wizard/stepper"
= form_with url: wizard_step_characters_path("klass"), method: :patch, scope: :wizard, class: "min-h-screen bg-[#0b0f19] pb-28 text-slate-100", data: { controller: "class-wizard" } do |form|
  %main.mx-auto.max-w-6xl.px-5.pb-12.pt-7.sm:px-8
    %h1.font-serif.text-3xl.font-semibold.uppercase Escolha sua classe
    %p.mt-2.text-slate-400 Sua classe define habilidades de combate, magias e estilo de aventura.
    .mt-7.grid.grid-cols-1.gap-4.md:grid-cols-2.xl:grid-cols-4{ data: { controller: "selection" } }
      - @classes.each do |klass|
        - selected = @wizard.dig("klass", "primary_class_id").to_s == klass.id.to_s
        - card_classes = selected ? "border-amber-500 bg-amber-500/5" : "border-slate-800"
        %label{ class: "cursor-pointer rounded-2xl border bg-slate-900 p-5 transition hover:border-amber-500 #{card_classes}", data: { selection_target: "card", action: "click->selection#choose" } }
          = form.radio_button :primary_class_id, klass.id, checked: selected, class: "sr-only", data: { selection_target: "input" }
          .flex.items-center.justify-between
            %span{ class: "rounded-full bg-violet-500/15 px-2.5 py-1 text-xs font-bold text-violet-400" }= klass.spellcasting_type == "none" ? "Guerreiro" : "Conjurador"
            %span.text-sm.text-slate-500= "d#{klass.hit_die}"
          %h2.mt-4.font-serif.text-lg.font-semibold= klass.name
          %p.mt-2.text-sm.text-slate-400= klass.primary_ability.upcase
          - role_class = klass.spellcasting_type == "none" ? "text-slate-500" : "text-violet-400"
          %p.mt-4.text-xs.font-semibold{ class: role_class }= klass.spellcasting_type == "none" ? "⚔ Marcial" : "✧ Conjurador"
    .mt-6.rounded-2xl.border.border-slate-800.bg-slate-900.p-5
      .flex.items-center.justify-between
        %p.font-semibold Nível Total: #{ @wizard.dig("klass", "primary_class_level") || 1 }
        %span.text-sm.text-amber-400 Máx. 20
      .mt-4.flex.items-center.gap-4
        %span.text-sm.text-slate-400 Classe primária
        = form.range_field :primary_class_level, value: @wizard.dig("klass", "primary_class_level") || 1, min: 1, max: 20, class: "w-full accent-amber-500", data: { class_wizard_target: "primaryLevel", action: "input->class-wizard#updateLevel" }
        %strong.text-amber-400{ data: { class_wizard_target: "levelOutput" } }= @wizard.dig("klass", "primary_class_level") || 1
    %section{ class: "mt-5 rounded-2xl border border-slate-800 bg-slate-950/30" }
      %label.flex.cursor-pointer.items-center.justify-between.p-5
        %span
          %strong.block Multiclasse
          %span.text-sm.text-slate-500 Combine duas classes no mesmo personagem
        = form.check_box :is_multiclass, checked: @wizard.dig("klass", "is_multiclass"), class: "sr-only peer", data: { class_wizard_target: "toggle", action: "class-wizard#toggle" }
        %span.h-7.w-12.rounded-full.bg-slate-700.p-1.transition.peer-checked:bg-violet-600
          %span.block.size-5.rounded-full.bg-white.transition.peer-checked:translate-x-5
      .hidden.border-t.border-slate-800.p-5{ data: { class_wizard_target: "secondary" } }
        %p.mb-4.text-sm.text-slate-400 Segunda classe — verifique os requisitos de atributo.
        .grid.grid-cols-2.gap-3.md:grid-cols-3{ data: { controller: "selection" } }
          - @classes.each do |klass|
            - selected_secondary = @wizard.dig("klass", "secondary_class_id").to_s == klass.id.to_s
            - secondary_card_classes = selected_secondary ? "border-amber-500 bg-amber-500/5 ring-1 ring-amber-500/40" : "border-slate-800 bg-slate-950/40"
            %label{ class: "cursor-pointer rounded-xl border p-3 text-sm transition hover:border-amber-500/70 #{secondary_card_classes}", data: { selection_target: "card", action: "click->selection#choose" } }
              = form.radio_button :secondary_class_id, klass.id, checked: selected_secondary, class: "sr-only", data: { selection_target: "input" }
              .flex.items-start.justify-between.gap-2
                %span.font-serif.font-semibold.text-slate-200= klass.name
                %span.text-xs.text-rose-400= "#{klass.primary_ability.upcase} 13+"
        .mt-4
          = form.label :secondary_class_level, "Nível da segunda classe", class: "text-sm text-slate-400"
          = form.range_field :secondary_class_level, value: @wizard.dig("klass", "secondary_class_level") || 1, min: 1, max: 20, class: "ml-3 accent-violet-500"
  = render "characters/wizard/footer", form: form
