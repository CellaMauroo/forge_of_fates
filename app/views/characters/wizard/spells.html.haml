- content_for(:full_width_layout, true)
- school_tones = { "Evocação" => "border-rose-500/30 bg-rose-500/10 text-rose-400", "Conjuração" => "border-emerald-500/30 bg-emerald-500/10 text-emerald-400", "Transmutação" => "border-cyan-500/30 bg-cyan-500/10 text-cyan-400", "Abjuração" => "border-blue-500/30 bg-blue-500/10 text-blue-400", "Encantamento" => "border-violet-500/30 bg-violet-500/10 text-violet-400", "Adivinhação" => "border-amber-500/30 bg-amber-500/10 text-amber-400", "Ilusão" => "border-indigo-500/30 bg-indigo-500/10 text-indigo-400", "Necromancia" => "border-fuchsia-500/30 bg-fuchsia-500/10 text-fuchsia-400" }
- selections = @wizard.dig("spells", "spell_selections").to_h
= render "characters/wizard/stepper"
= form_with url: wizard_step_characters_path("spells"), method: :patch, scope: :wizard, class: "min-h-screen bg-[#0b0f19] pb-28 text-slate-100", data: { controller: "spell-picker", spell_picker_limits_value: @spell_limits.to_json } do |form|
  %main{ class: "mx-auto max-w-6xl px-5 pb-12 pt-7 sm:px-8" }
    .flex.items-end.justify-between.gap-5
      %div
        %h1.font-serif.text-3xl.font-semibold.uppercase Grimório de magias
        %p.mt-2.text-slate-400 Escolha as magias liberadas para as classes e níveis do personagem.
      %div.text-right
        %strong.block.text-3xl.text-violet-400{ data: { spell_picker_target: "count" } } 0
        %span.text-sm.text-slate-500 selecionadas
    - if @can_select_spells
      %section{ class: "mt-6 rounded-2xl border border-violet-500/25 bg-slate-900 p-4" }
        %p.text-sm.font-semibold.text-slate-300 Limites por classe
        .mt-3.flex.flex-wrap.gap-2
          - @spell_classes.each do |choice|
            - klass = choice[:klass]
            - cantrip_limit = @spellcasting.selection_limit_for(klass, cantrip: true)
            - spell_limit = @spellcasting.selection_limit_for(klass, cantrip: false)
            - progression = choice[:progression]
            - slots = progression.spell_slots.to_h.sort_by { |level, _count| level.to_i }.map { |level, count| "#{level}º: #{count}" }.join(" · ")
            %div.rounded-xl.bg-slate-800.px-3.py-2.text-xs.text-slate-300
              %strong.text-slate-100= "#{klass.name} Nv.#{choice[:level]}"
              %span= " · círculo #{progression.highest_spell_level}º"
              %div.mt-1.flex.flex-wrap.gap-x-2.gap-y-1
                %span{ data: { spell_picker_target: "limit", class_id: klass.id, bucket: "cantrips" } }= "0/#{cantrip_limit} truques"
                %span{ data: { spell_picker_target: "limit", class_id: klass.id, bucket: "spells" } }= "0/#{spell_limit} magias"
              - if slots.present?
                %div.mt-1.text-slate-500= "Slots: #{slots}"
      .mt-6.flex.flex-wrap.gap-2
        %button{ class: "cursor-pointer rounded-xl bg-violet-600 px-4 py-2 text-sm font-semibold text-white", type: "button", aria: { selected: true }, data: { spell_picker_target: "filterButton", action: "spell-picker#filter", level: "all" } } Todas
        - (0..9).each do |level|
          %button{ class: "cursor-pointer rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-slate-400", type: "button", aria: { selected: false }, data: { spell_picker_target: "filterButton", action: "spell-picker#filter", level: level } }= level.zero? ? "Truques" : "#{level}º Nível"
      .mt-4.grid.gap-3.sm:grid-cols-3
        %input{ class: "rounded-xl border border-slate-800 bg-slate-900 px-4 py-2 text-sm text-slate-100", type: "search", placeholder: "Buscar magia", data: { spell_picker_target: "search", action: "input->spell-picker#search" } }
        %select{ class: "cursor-pointer rounded-xl border border-slate-800 bg-slate-900 px-4 py-2 text-sm text-slate-100", data: { spell_picker_target: "classFilter", action: "change->spell-picker#filterClass" } }
          %option{ value: "all" } Todas as classes
          - @spell_classes.each do |choice|
            %option{ value: choice[:klass].id }= choice[:klass].name
        %select{ class: "cursor-pointer rounded-xl border border-slate-800 bg-slate-900 px-4 py-2 text-sm text-slate-100", data: { spell_picker_target: "schoolFilter", action: "change->spell-picker#filterSchool" } }
          %option{ value: "all" } Todas as escolas
          - @spells.map(&:school).uniq.sort.each do |school|
            %option{ value: school }= school
      .mt-6.grid.grid-cols-1.gap-4.md:grid-cols-2
        - @spells.each do |spell|
          - saved = selections[spell.id.to_s].to_h
          - sources = @spell_classes.select { |choice| ClassSpell.exists?(class_id: choice[:klass].id, spell_id: spell.id) }
          - allowed_sources = sources.select { |choice| @spellcasting.allowed_for?(spell, choice[:klass]) }
          - saved_source_id = saved["source_class_id"].to_s
          - source_id = allowed_sources.find { |source| source[:klass].id.to_s == saved_source_id }&.dig(:klass)&.id || allowed_sources.first&.dig(:klass)&.id
          - selected = ActiveModel::Type::Boolean.new.cast(saved["selected"]) && source_id.present?
          - access_message = "Requer acesso ao #{spell.level}º círculo. " + sources.map { |source| "#{source[:klass].name}: até #{source[:progression].highest_spell_level}º" }.join(" · ")
          - card_classes = selected ? "border-violet-500 bg-violet-500/5 ring-1 ring-violet-500/40" : "border-slate-800"
          - school_tone = school_tones.fetch(spell.school, "border-slate-700 bg-slate-800 text-slate-300")
          %article{ class: "rounded-2xl border bg-slate-900 p-5 transition #{card_classes}", data: { spell_picker_target: "card", level: spell.level, classes: sources.map { |source| source[:klass].id }.join(","), available_classes: allowed_sources.map { |source| source[:klass].id }.join(","), school: spell.school, name: spell.name.downcase, default_source: source_id } }
            %input{ type: "hidden", name: "wizard[spell_selections][#{spell.id}][spell_id]", value: spell.id }
            .flex.items-center.gap-2
              %span{ class: "rounded border px-2 py-1 text-xs font-bold #{school_tone}" }= spell.school
              %span.text-xs.text-slate-500= spell.level.zero? ? "Truque" : "#{spell.level}º Nível"
              %label.ml-auto.flex.cursor-pointer.items-center.gap-2.text-sm.font-semibold.text-violet-300
                %input{ class: "size-4 cursor-pointer accent-violet-500", type: "checkbox", name: "wizard[spell_selections][#{spell.id}][selected]", value: "1", checked: selected, disabled: allowed_sources.empty?, data: { spell_picker_target: "input", action: "change->spell-picker#select" } }
                = allowed_sources.empty? ? "Bloqueada" : "Escolher"
            %h2.mt-3.font-serif.text-xl.font-semibold= spell.name
            %p.mt-2.text-sm.text-slate-400= spell.description.to_s.truncate(130)
            - if allowed_sources.empty?
              %p.mt-3.text-sm.font-semibold.text-amber-400= access_message
            - elsif allowed_sources.size > 1
              %label.mt-4.block.text-xs.font-semibold.text-slate-400
                Classe de origem
                %select{ class: "mt-1 w-full cursor-pointer rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100", name: "wizard[spell_selections][#{spell.id}][source_class_id]", data: { spell_picker_target: "source", action: "change->spell-picker#sourceChanged" } }
                  - allowed_sources.each do |source|
                    %option{ value: source[:klass].id, selected: source_id.to_s == source[:klass].id.to_s }= source[:klass].name
            - elsif allowed_sources.one?
              %input{ type: "hidden", name: "wizard[spell_selections][#{spell.id}][source_class_id]", value: source_id }
    - else
      %section.mt-8.rounded-2xl.border.border-slate-800.bg-slate-900.p-7.text-center
        %div.mx-auto.flex.size-12.items-center.justify-center.rounded-full.bg-slate-800.text-2xl.text-slate-400 ✦
        %h2.mt-4.font-serif.text-xl.font-semibold Este personagem não possui conjuração
        %p.mx-auto.mt-2.max-w-xl.text-sm.leading-6.text-slate-400
          As classes escolhidas ainda não concedem acesso a magias. Você poderá criar o personagem sem selecioná-las.
  = render "characters/wizard/footer", form: form
