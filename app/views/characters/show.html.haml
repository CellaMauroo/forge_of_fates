- content_for(:full_width_layout, true)
- school_tones = { "Evocação" => "border-rose-500/30 bg-rose-500/10 text-rose-400", "Conjuração" => "border-emerald-500/30 bg-emerald-500/10 text-emerald-400", "Transmutação" => "border-cyan-500/30 bg-cyan-500/10 text-cyan-400", "Abjuração" => "border-blue-500/30 bg-blue-500/10 text-blue-400", "Encantamento" => "border-violet-500/30 bg-violet-500/10 text-violet-400", "Adivinhação" => "border-amber-500/30 bg-amber-500/10 text-amber-400", "Ilusão" => "border-indigo-500/30 bg-indigo-500/10 text-indigo-400" }
- abilities = { "FOR" => :str, "DES" => :dex, "CON" => :con, "INT" => :int, "SAB" => :wis, "CAR" => :cha }
%div{ class: "min-h-screen bg-[#0b0f19] pb-12 text-slate-100" }
  %header{ class: "mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8" }
    = link_to characters_path, class: "cursor-pointer text-sm font-semibold text-slate-400 hover:text-white" do
      ← Meus Personagens
    %span.font-serif.font-bold.text-amber-400 Forge of Fates
    %span.w-28
  %main{ class: "mx-auto max-w-7xl px-5 sm:px-8" }
    %section{ class: "rounded-3xl border border-slate-800 bg-slate-900 p-6 sm:p-7" }
      .flex.items-start.gap-5
        %span{ class: "flex size-20 shrink-0 items-center justify-center rounded-3xl border border-amber-500/25 bg-slate-950 font-serif text-3xl font-bold text-amber-400" }= @character.character_name.first.upcase
        .min-w-0.flex-1
          %h1{ class: "font-serif text-3xl font-semibold uppercase sm:text-4xl" }= @character.character_name
          .mt-3.flex.flex-wrap.items-center.gap-2.text-sm
            %span.text-slate-400= @character.ancestry_name
            %span.text-slate-700 ·
            %span{ class: "rounded-full border border-violet-500/30 bg-violet-500/10 px-3 py-1 font-semibold text-violet-400" }= "✧ #{@character.primary_class_name} Nv.#{@character.level}"
            %span.rounded-full.bg-slate-800.px-3.py-1.font-semibold.text-slate-300= "✧ +#{@character.proficiency_bonus} Proficiência"
      .mt-5.flex.items-center.justify-between.text-sm.text-slate-500
        %span XP
        %span= "#{number_with_delimiter(@character.experience_points, delimiter: '.') } / 6.500"
      .mt-2.h-2.overflow-hidden.rounded-full.bg-slate-950
        %div.h-full.rounded-full.bg-amber-500{ style: "width: #{[ (@character.experience_points.to_f / 6500 * 100), 100 ].min}%" }
    %div{ class: "mt-4 grid gap-4 lg:grid-cols-12" }
      %section{ class: "rounded-3xl border border-rose-500/25 bg-slate-900 p-5 lg:col-span-6", data: { controller: "hp-tracker", hp_tracker_url_value: hit_points_character_path(@character), hp_tracker_current_value: @character.hp_current, hp_tracker_maximum_value: @character.maximum_hit_points } }
        %p.text-sm.font-semibold.text-slate-400 ♥ Pontos de Vida
        .mt-2
          %strong.text-4xl.text-emerald-400{ data: { hp_tracker_target: "current" } }= @character.hp_current
          %span.ml-2.text-2xl.text-slate-500= "/ #{@character.maximum_hit_points}"
        .mt-3.h-2.overflow-hidden.rounded-full.bg-slate-950
          %div.h-full.rounded-full.bg-emerald-500.transition-all{ data: { hp_tracker_target: "bar" }, style: "width: #{(@character.hp_current.to_f / @character.maximum_hit_points * 100).round}%" }
        .mt-4.grid.grid-cols-2.gap-3
          %button{ class: "cursor-pointer rounded-xl bg-rose-500/15 py-3 text-sm font-bold text-rose-400", type: "button", data: { action: "hp-tracker#damage" } } − Dano
          %button{ class: "cursor-pointer rounded-xl bg-emerald-500/15 py-3 text-sm font-bold text-emerald-400", type: "button", data: { action: "hp-tracker#heal" } } + Cura
      %section{ class: "flex flex-col items-center justify-center rounded-3xl border border-slate-800 bg-slate-900 p-5 lg:col-span-3" }
        %span.text-2xl.text-slate-400 ⛨
        %strong.mt-1.text-4xl= @character.armor_class
        %span.mt-1.text-sm.text-slate-500 Classe de Armadura
      %section{ class: "rounded-3xl border border-slate-800 bg-slate-900 p-5 lg:col-span-3" }
        .flex.items-center.justify-between.border-b.border-slate-800.pb-4
          %span.text-sm.text-slate-500 ⚡ Deslocamento
          %strong= "#{@character.speed_in_feet || 0}ft"
        .flex.items-center.justify-between.pt-4
          %span.text-sm.text-slate-500 ♨ Iniciativa
          - dex = @character.ability_modifier(:dex)
          %strong{ class: dex.negative? ? "text-rose-400" : "text-emerald-400" }= dex.positive? ? "+#{dex}" : dex
    %div{ class: "mt-4 grid gap-4 lg:grid-cols-2" }
      .space-y-4
        %section.rounded-3xl.border.border-slate-800.bg-slate-900.p-6
          %h2.font-serif.text-lg.font-semibold.uppercase Atributos
          .mt-5.grid.grid-cols-3.gap-3
            - abilities.each do |short, ability|
              - score = @character.public_send("#{ability}_base")
              - modifier = @character.ability_modifier(ability)
              %div.rounded-2xl.bg-slate-950.p-4.text-center
                %p.font-serif.text-sm.font-bold.text-slate-500= short
                %strong.mt-2.block.text-3xl{ class: modifier.negative? ? "text-rose-400" : "text-slate-200" }= modifier.positive? ? "+#{modifier}" : modifier
                %p.mt-2.border-t.border-slate-800.pt-2.text-sm.text-slate-500= score
        %section.rounded-3xl.border.border-slate-800.bg-slate-900.p-6
          %h2.font-serif.text-lg.font-semibold.uppercase Perícias
          .mt-4.space-y-3
            - Character::SKILLS.each do |name, ability|
              - proficient = @character.proficiencies.any? { |item| item.name == name }
              - bonus = @character.skill_bonus(name)
              %div{ class: "grid grid-cols-[16px_1fr_auto_auto] items-center gap-3 text-sm" }
                %span{ class: proficient ? "size-2 rounded-full bg-emerald-400" : "size-2 rounded-full border border-slate-700" }
                %span{ class: proficient ? "font-semibold text-slate-200" : "text-slate-400" }= name
                %span.text-xs.text-slate-600= ability.to_s.upcase
                %strong{ class: bonus.negative? ? "text-rose-400" : "text-emerald-400" }= bonus.positive? ? "+#{bonus}" : bonus
      .space-y-4
        %section{ class: "rounded-3xl border border-violet-500/25 bg-slate-900 p-6", data: { controller: "spell-slots", spell_slots_url_value: spell_slot_character_path(@character) } }
          %h2.font-serif.text-lg.font-semibold.uppercase Espaços de Magia
          - @character.spell_slots.each do |spell_level, count|
            - state = @character.spell_slots_state.fetch(spell_level.to_s, {})
            .mt-5
              .flex.justify-between.text-sm
                %span.font-semibold.text-slate-400= "#{spell_level}º Nível"
                %span.text-violet-400= "#{count - state.values.count(true)} / #{count} disponíveis"
              .mt-3.grid.gap-3{ class: "grid-cols-#{count}" }
                - count.times do |index|
                  - spent = state[index.to_s]
                  - slot_classes = spent ? "cursor-pointer rounded-xl border border-slate-700 bg-slate-950 py-3 text-lg text-slate-600 transition" : "cursor-pointer rounded-xl border border-violet-500/50 bg-violet-500/15 py-3 text-lg text-violet-400 transition"
                  %button{ class: slot_classes, type: "button", data: { spell_slots_target: "slot", action: "spell-slots#toggle", level: spell_level, slot: index, spent: spent } } ✧
          %p.mt-5.text-sm.text-slate-600 Clique em um slot para gastar ou recuperar espaços de magia.
        %section.rounded-3xl.border.border-slate-800.bg-slate-900.p-6
          %h2.font-serif.text-lg.font-semibold.uppercase Magias Conhecidas
          - if @character.spells.any?
            %div{ class: "mt-4 grid gap-3 sm:grid-cols-2" }
              - @character.spells.each do |spell|
                - tone = school_tones.fetch(spell.school, "border-slate-700 bg-slate-800 text-slate-300")
                %article.rounded-2xl.border.border-slate-800.bg-slate-950.p-4
                  .flex.items-center.gap-2
                    %span{ class: "rounded border px-2 py-1 text-xs font-bold #{tone}" }= spell.school
                    %span.text-xs.text-slate-500= spell.level.zero? ? "Truque" : "#{spell.level}º Nível"
                  %h3.mt-3.font-semibold= spell.name
                  %p.mt-1.text-sm.text-slate-500= spell.description.to_s.truncate(95)
          - else
            %p.py-12.text-center.text-slate-600 Nenhuma magia selecionada.
