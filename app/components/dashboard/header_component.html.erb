<header class="border-b border-slate-800/90 bg-slate-950/95 backdrop-blur">
  <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-6 lg:px-8">
    <%= link_to root_path, class: "flex shrink-0 items-center gap-2.5 text-white" do %>
      <span class="flex size-8 items-center justify-center rounded-xl border border-amber-500/35 bg-amber-500/10 text-amber-400">
        <%= helpers.lucide_icon("sword", size: 16, "aria-hidden": true) %>
      </span>
      <span class="font-serif text-base font-semibold tracking-tight sm:text-lg">Forge of Fates</span>
    <% end %>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegação principal">
      <%= link_to "Personagens", root_path, class: "rounded-lg bg-amber-500/10 px-3.5 py-2 text-sm font-semibold text-amber-400" %>
      <%= link_to "Campanhas", coming_soon_path(feature: "Campanhas"), class: "cursor-pointer rounded-lg px-3.5 py-2 text-sm font-medium text-slate-500 transition hover:bg-slate-900 hover:text-slate-300" %>
      <%= link_to "Bestiário", coming_soon_path(feature: "Bestiário"), class: "cursor-pointer rounded-lg px-3.5 py-2 text-sm font-medium text-slate-500 transition hover:bg-slate-900 hover:text-slate-300" %>
    </nav>

    <details class="group relative shrink-0">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-xl border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-left marker:content-none hover:border-slate-600 [&::-webkit-details-marker]:hidden">
        <span class="flex size-7 items-center justify-center rounded-lg bg-violet-500/15 text-xs font-bold text-violet-300"><%= user.initials %></span>
        <span class="hidden min-w-0 sm:block">
          <span class="block max-w-28 truncate text-xs font-semibold text-slate-100"><%= user.display_name %></span>
          <span class="block text-[11px] text-slate-500">Aventureiro</span>
        </span>
        <%= helpers.lucide_icon("chevron-down", size: 15, class: "hidden text-slate-500 sm:block", "aria-hidden": true) %>
      </summary>

      <div class="absolute right-0 z-20 mt-2 hidden w-60 rounded-xl border border-slate-700 bg-slate-900 p-2 shadow-2xl shadow-slate-950/50 group-open:block">
        <p class="truncate px-2 py-2 text-xs text-slate-400"><%= user.email_address %></p>
        <%= button_to "Sair da conta", session_path, method: :delete, class: "w-full rounded-lg px-2 py-2 text-left text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white" %>
      </div>
    </details>
  </div>
</header>
