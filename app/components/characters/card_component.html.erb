<article class="group overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/80 shadow-lg shadow-slate-950/10 transition duration-200 hover:-translate-y-0.5 hover:border-slate-700 hover:shadow-slate-950/30">
  <div class="p-5">
    <div class="flex items-start gap-3">
      <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl border text-lg font-serif font-semibold <%= tone[:avatar] %>"><%= character_initial %></span>
      <div class="min-w-0 flex-1">
        <h3 class="truncate font-serif text-lg font-semibold text-white"><%= character.character_name %></h3>
        <p class="mt-0.5 truncate text-sm text-slate-500"><%= character.ancestry_name %></p>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-950/50 px-2.5 py-1.5 text-center">
        <span class="block text-[10px] font-medium uppercase tracking-wide text-slate-500">Nv.</span>
        <span class="block text-lg font-bold leading-5 text-slate-100"><%= character.total_level %></span>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <span class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-400"><%= class_label %></span>
      <% if spell_count.positive? %>
        <span class="rounded-full border border-violet-500/25 bg-violet-500/10 px-2.5 py-1 text-xs font-semibold text-violet-400"><%= spell_count %> <%= spell_count == 1 ? "magia" : "magias" %></span>
      <% end %>
    </div>

    <div class="mt-5">
      <div class="flex items-center justify-between text-xs">
        <span class="flex items-center gap-1.5 text-slate-500">
          <%= helpers.lucide_icon("heart", size: 13, class: "text-rose-400", "aria-hidden": true) %>
          PV atual
        </span>
        <span class="font-semibold tabular-nums text-emerald-400"><%= character.hp_current %> PV</span>
      </div>
      <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-800" aria-hidden="true">
        <div class="h-full w-full rounded-full <%= tone[:accent] %>"></div>
      </div>
      <% if character.hp_temp.positive? %>
        <p class="mt-1.5 text-xs text-cyan-400">+<%= character.hp_temp %> PV temporários</p>
      <% end %>
    </div>

    <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
      <span>XP</span>
      <span class="tabular-nums"><%= number_with_delimiter(character.experience_points, delimiter: ".") %></span>
    </div>

    <dl class="mt-2 grid grid-cols-3 gap-2">
      <div class="rounded-xl border border-slate-800 bg-slate-950/45 px-2 py-2.5 text-center">
        <dt class="text-[11px] text-slate-500">FOR</dt>
        <dd class="mt-0.5 text-sm font-semibold text-slate-100"><%= ability_modifier(:str) %></dd>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-950/45 px-2 py-2.5 text-center">
        <dt class="text-[11px] text-slate-500">DES</dt>
        <dd class="mt-0.5 text-sm font-semibold text-slate-100"><%= ability_modifier(:dex) %></dd>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-950/45 px-2 py-2.5 text-center">
        <dt class="text-[11px] text-slate-500">Vel.</dt>
        <dd class="mt-0.5 text-sm font-semibold text-slate-100"><%= character.speed_in_feet ? "#{character.speed_in_feet}ft" : "—" %></dd>
      </div>
    </dl>
  </div>

  <footer class="flex items-center justify-between border-t border-slate-800 bg-slate-950/25 px-5 py-3">
    <span class="flex items-center gap-1.5 text-xs text-slate-600">
      <%= helpers.lucide_icon("clock-3", size: 13, "aria-hidden": true) %>
      <%= updated_at_label %>
    </span>
    <%= link_to character_path(character), class: "inline-flex cursor-pointer items-center gap-1 rounded-lg border border-amber-500/35 bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-amber-400 transition hover:border-amber-400/60 hover:bg-amber-500/15" do %>
      Ver ficha
      <%= helpers.lucide_icon("chevron-right", size: 14, "aria-hidden": true) %>
    <% end %>
  </footer>
</article>
